# cargoless — local operator environment template.
#
# Copy to `.env` and fill in your own deployment's values:
#
#     cp .env.example .env
#     set -a && . ./.env && set +a
#
# `.env` is gitignored (see .gitignore) and MUST stay that way — it is the only
# place deployment-specific values and secrets belong. This repo is open source;
# nothing here should ever carry a real token, host, or cluster identifier.
#
# The runbooks under docs/operator/ read these rather than hard-coding one
# deployment's topology, so the commands are copy-pasteable anywhere.

# ---- Secrets ---------------------------------------------------------------

# Bearer token for the cargoless-serve HTTP API (/status, /overlay,
# /admin/active). Operator-provisioned; in a Kubernetes deployment this is
# typically sourced from a Secret rather than pasted here. NEVER commit a value.
CARGOLESS_AUTH_TOKEN=

# ---- Deployment topology ---------------------------------------------------

# Kubernetes namespace hosting the cargoless daemons.
CARGOLESS_NS=

# Pod running the witness tier (CARGOLESS_PROJECT_CHECKS_MODE=warn).
# Resolve dynamically rather than pinning a hashed pod name:
#   kubectl -n "$CARGOLESS_NS" get pod \
#     -l app.kubernetes.io/name=cargoless-serve-witness -o name | head -1
CARGOLESS_WITNESS_POD=

# Pod running the canonical RA-native verdict lane
# (CARGOLESS_PROJECT_CHECKS_MODE=off). Used for steady-state RA comparisons.
CARGOLESS_CANONICAL_POD=

# Absolute worktree path the daemon analyzes, as passed to /status?worktree=.
CARGOLESS_WORKTREE=

# ---- Optional --------------------------------------------------------------

# Base URL of the Forgejo instance, if you script against its API.
CARGOLESS_FORGE_URL=

# Node the witness pod is scheduled on. Only needed when assessing the blast
# radius of raising a memory limit — see the P0b note in
# docs/operator/HANDOVER-2026-07-28-RA-REAP-STRANDS-WITNESS.md.
CARGOLESS_WITNESS_NODE=
